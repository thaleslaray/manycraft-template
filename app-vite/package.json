{
  "name": "app-vite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings src",
    "dev:local": "node scripts/dev-local.mjs",
    "test:worker": "node --test scripts/worker.test.mjs",
    "test": "node --test src/data/*.test.mjs src/components/*/*.test.mjs src/components/*/*.test.ts scripts/worker.test.mjs e2e/*.test.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@arco-themes/react-easy-email-theme": "^0.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "easy-email-core": "^4.17.1",
    "easy-email-editor": "^4.17.1",
    "easy-email-extensions": "^4.17.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "mjml-browser": "^4.18.0",
    "qrcode-generator": "^1.4.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dom18": "npm:react-dom@^18.3.1",
    "react-final-form": "^6.5.9",
    "react-router": "^8.5.0",
    "react18": "npm:react@^18.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  }
}
