# Copie para .dev.vars. Preencha localmente; nunca versione credenciais.
# Preencha APP_ENV com development localmente. Use HTTPS para cookies Secure.
DEV_AUTO_LOGIN=
DEV_WORKSPACE_ID=
APP_ENV=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Entrada por senha: "1" liga. Desligada por padrão, no local e em produção (entra-se por código no e-mail ou pelo Google).
# PASSWORD_LOGIN=1
# Teto de códigos de login por dia (padrão 100 fora do desenvolvimento; no local só vale se definido; 0 desliga).
# OTP_DAILY_LIMIT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_FROM=
# Domínio reservado de desenvolvimento; produção exige domínio próprio autenticado.
EMAIL_DEFAULT_DOMAIN=mail.replica.test
MEDIA_PUBLIC_URL=
# Chave mestra das conexões (única credencial de canal no ambiente): 32 bytes em base64.
# Gere com: openssl rand -base64 32   (em produção: wrangler secret put CONNECTIONS_KEK_V1)
# Trocar de chave = criar CONNECTIONS_KEK_V2, apontar CONNECTIONS_KEK_ACTIVE=2 e manter a V1 enquanto houver linhas nela.
CONNECTIONS_KEK_V1=
CONNECTIONS_KEK_ACTIVE=1
# URL pública do painel/engine para o webhook de cada conexão (opcional; padrão: origem da requisição).
PUBLIC_BASE_URL=
# Só desenvolvimento: aponta as conexões novas para uma API de provedor falsa (jornadas no navegador).
DEV_PROVIDER_API_BASE=
